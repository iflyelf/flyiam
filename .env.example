# Environment variables for FlyIAM

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flyiam
DB_USER=flyiam
DB_PASSWORD=flyiam_password
DB_SSLMODE=disable

# ==================== Redis 配置 ====================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT 配置 ====================
# 注意：生产环境请务必修改为随机字符串（32位以上）
JWT_SECRET=flyiam-jwt-secret-key-for-development-only
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ==================== 管理员配置 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# ==================== Casdoor 配置 ====================
# 后端访问地址（本地开发指向容器内网）
CASDOOR_ENDPOINT=http://localhost:8000
# 浏览器访问地址；外置域名默认走标准端口，无需显式书写端口号
#   https://casdoor.example.com → 443，http://casdoor.example.com → 80
CASDOOR_PUBLIC_ENDPOINT=http://localhost:8000
# 应用凭据留空则由程序自动创建并持久化
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_CERTIFICATE=cert-built-in
CASDOOR_ORGANIZATION=flyiam
CASDOOR_ORGANIZATION_DISPLAY_NAME=FlyIAM
CASDOOR_APPLICATION=flyiam
CASDOOR_APPLICATION_DISPLAY_NAME=FlyIAM
CASDOOR_DEFAULT_PASSWORD=ysyh!9Sky
CASDOOR_COUNTRY_CODE=CN
CASDOOR_AUTO_SETUP=true
CASDOOR_AUTO_REDIRECT_URI=true

# 数据源已改为「数据同步」页面管理（存储于数据库），无需环境变量配置

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== 服务配置 ====================
SERVER_PORT=8081
SERVER_MODE=release
